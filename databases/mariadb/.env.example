# MariaDB 环境配置示例
# 复制成 .env 再改：cp .env.example .env
# 生成随机密码：openssl rand -base64 24

TZ=Asia/Tokyo

# 宿主机端口。用 3307 是为了跟 MySQL 的 3306 错开
MARIADB_PORT=3307

# root 密码，必填
MARIADB_ROOT_PASSWORD=change_me_root_password

# 首次启动时自动创建的库和用户
MARIADB_DATABASE=default_db
MARIADB_USER=admin

# 上面这个用户的密码，必填
MARIADB_PASSWORD=change_me_password

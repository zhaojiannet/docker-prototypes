# 复制成 .env 再改：cp .env.example .env

# compose 项目名，也是容器名前缀
COMPOSE_PROJECT_NAME=myproject

# 容器的时区，日志时间和程序取的本地时间都按它
TZ=Asia/Tokyo

# 不用 OrbStack 域名、改用 localhost 加端口访问时，取消下面两行的注释
#COMPOSE_FILE=compose.yaml:compose.ports.yaml
#APP_PORT=4321

# 部署到自建服务器时才填，dp deploy、patch、backup 读这三项，见仓库 templates/deploy
#DEPLOY_MODE=pull
#DEPLOY_HOST=
#DEPLOY_DIR=

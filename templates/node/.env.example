# 复制成 .env 再改：cp .env.example .env

# compose 项目名，也是容器名前缀
COMPOSE_PROJECT_NAME=myproject

# 容器的时区，日志时间和程序取的本地时间都按它
TZ=Asia/Tokyo

# 部署到自建服务器时才填，dp deploy、patch、backup 读这三项，见 docker-prototypes 仓库的 templates/deploy
#DEPLOY_MODE=pull
#DEPLOY_HOST=
#DEPLOY_DIR=
# 推送模式下构建产物不在 app/dist 时写，相对 app/，例如 Nuxt generate 是 .output/public
#OUTPUT_DIR=dist
